{
    "name": "@source-repo/relational",
    "version": "5.3.1",
    "description": "Source Relational: serve an existing SQL database to a Source RPC network as DataProvider resources, over Kysely",
    "keywords": [
        "rpc",
        "sql",
        "kysely",
        "dataprovider",
        "postgres",
        "sqlite",
        "mysql",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/relational"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./writes": {
            "types": "./dist/WriteService.d.ts",
            "default": "./dist/WriteService.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/Fixture.*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run clean && npm run build && ava",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@source-repo/rpc": "^5.3.1",
        "kysely": "^0.29.5"
    },
    "devDependencies": {
        "@source-repo/conformance": "^5.3.1",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.21.0",
        "ava": "^8.0.1",
        "mysql2": "^3.23.3",
        "pg": "^8.23.0",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "ava": {
        "files": [
            "dist/**/*.test.js"
        ],
        "workerThreads": false,
        "concurrency": 1
    },
    "homepage": "https://github.com/source-repo/rpc/tree/main/packages/relational#readme",
    "bugs": {
        "url": "https://github.com/source-repo/rpc/issues"
    }
}
