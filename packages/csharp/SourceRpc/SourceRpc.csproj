<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The protocol, with no transport in it.
    
    Deliberately not an ASP.NET Core library: a SignalR hub needs that framework and an MQTT or
    socket.io client does not, so anything they share has to be reachable without it. What lives
    here is the frame, the dispatcher, the client, the routing tables and the error model - the
    things three bindings would otherwise each reimplement slightly differently.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SourceRpc</RootNamespace>
    <AssemblyName>SourceRpc</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SourceRpc</PackageId>
    <Version>4.6.0</Version>
    <Authors>anderswestberg</Authors>
    <Description>Source RPC for .NET: the flat frame, the dispatcher, the client and the error model, with no transport bound in. Carried by SourceRpc.SignalR and whatever else implements ISourceRpcTransport.</Description>
    <PackageTags>rpc;msgrpc;automation;iiot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/source-repo/rpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/source-repo/rpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- See the note in SourceRpc.SignalR.csproj: the XML ships, but a member whose name has already
         said it does not also need a ceremonial sentence. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack.Annotations" Version="2.5.192" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bindings are the intended users of the routing tables; consumers are not, because those
         tables have already changed twice and will change again when a third transport lands. -->
    <InternalsVisibleTo Include="SourceRpc.SignalR" />
    <InternalsVisibleTo Include="SourceRpc.SocketIo" />
    <InternalsVisibleTo Include="SourceRpc.Mqtt" />
  </ItemGroup>

</Project>
