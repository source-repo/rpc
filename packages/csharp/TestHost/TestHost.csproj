<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Not shipped and not a sample to copy: the minimum surface `Interop.test.ts` needs in order to
    be pointed at something real. The reference itself is the project beside this one.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SourceRpc.SignalR.TestHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SourceRpc.SignalR/SourceRpc.SignalR.csproj" />
    <ProjectReference Include="../SourceRpc.Mqtt/SourceRpc.Mqtt.csproj" />
  </ItemGroup>

</Project>
