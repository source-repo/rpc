<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Not shipped and not a sample to copy: the minimum surface `Interop.test.ts` needs in order to
    be pointed at something real. The reference itself is the project beside this one.
  -->
  <PropertyGroup>
    <!-- Not packable, so nothing consumes its XML - and generating it fails here anyway: this file
         uses top-level statements, where a /// comment on a local function is CS1587. The comments
         are worth more than the file nobody reads. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SourceRpc.SignalR.TestHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SourceRpc.SignalR/SourceRpc.SignalR.csproj" />
    <ProjectReference Include="../SourceRpc.Mqtt/SourceRpc.Mqtt.csproj" />
    <ProjectReference Include="../SourceRpc.SocketIo/SourceRpc.SocketIo.csproj" />
  </ItemGroup>

</Project>
