<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The socket.io binding, and a client only.

    There is no server here, and that is a judgement rather than an omission: socket.io's server is
    a Node library with no maintained .NET equivalent, and a half-built one would be a protocol
    surface nobody could stand behind. A .NET process that wants to *be* served dials out to a
    TypeScript socket.io server with this, or serves SignalR with SourceRpc.SignalR, which is the
    same shape in the world that has a server.

    Like the MQTT binding, this references no ASP.NET Core - a console app, a service or a Windows
    Forms tool can take part without pulling a web stack in behind it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SourceRpc.SocketIo</RootNamespace>
    <AssemblyName>SourceRpc.SocketIo</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SourceRpc.SocketIo</PackageId>
    <Version>4.7.0</Version>
    <Authors>anderswestberg</Authors>
    <Description>Source RPC over socket.io, for a .NET peer that dials out to a TypeScript socket.io server. Client only - socket.io has no maintained .NET server.</Description>
    <PackageTags>socketio;rpc;msgrpc;automation;iiot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/source-repo/rpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/source-repo/rpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SocketIOClient" Version="4.0.5" />
    <PackageReference Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SourceRpc/SourceRpc.csproj" />
  </ItemGroup>

</Project>
