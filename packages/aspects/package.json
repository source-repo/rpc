{
    "name": "@source-repo/aspects",
    "version": "0.3.0",
    "description": "Several structures over the same objects, and links that keep their context - IEC 81346's aspects, over Source RPC",
    "keywords": [
        "aspects",
        "structures",
        "rpc",
        "tree",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/aspects"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run clean && npm run build && ava",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@source-repo/rpc": "^5.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "ava": "^8.0.1",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "ava": {
        "files": [
            "dist/**/*.test.js"
        ],
        "workerThreads": false,
        "concurrency": 1
    },
    "homepage": "https://github.com/source-repo/rpc/tree/main/packages/aspects#readme",
    "bugs": {
        "url": "https://github.com/source-repo/rpc/issues"
    }
}
