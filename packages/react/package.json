{
    "name": "@source-repo/react",
    "version": "0.1.0",
    "description": "A resource UI toolkit for Source RPC: schema-derived tables, trees, records, forms and search over $data, with the rules kept out of the components",
    "keywords": [
        "rpc",
        "react",
        "data-provider",
        "scada",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/react"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@source-repo/query": "^5.3.2",
        "@source-repo/rpc": "^5.3.2"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "react": "^19.2.0",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
