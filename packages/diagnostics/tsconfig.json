{
    "compilerOptions": {
        "target": "ES2022",
        // ES2024 for the library only, and for one symbol: Atomics.waitAsync, which is how the
        // supervisor waits for a pause without becoming the thing that is paused. The emit target
        // stays where it was - this asks the type system to know about a method the engines this
        // package supports have had for years, not to compile differently.
        "lib": ["ES2024"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,

        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"]
}
