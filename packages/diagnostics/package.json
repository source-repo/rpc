{
    "name": "@source-repo/diagnostics",
    "version": "5.2.0",
    "description": "Live values beside the source that declares them: a build-time binding catalogue, an active-source identity, and a node service that serves both - carrying no values and needing no instrumentation",
    "keywords": [
        "rpc",
        "diagnostics",
        "source",
        "observability",
        "plc",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/diagnostics"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./catalogue": {
            "types": "./dist/Catalogue.d.ts",
            "default": "./dist/Catalogue.js"
        },
        "./variant": {
            "types": "./dist/Variant.d.ts",
            "default": "./dist/Variant.js"
        },
        "./probes": {
            "types": "./dist/Probes.d.ts",
            "default": "./dist/Probes.js"
        },
        "./session": {
            "types": "./dist/Session.d.ts",
            "default": "./dist/Session.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/fixture"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run clean && npm run build && ava",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@source-repo/continuity": "^5.2.0",
        "@source-repo/rpc": "^5.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "ava": "^8.0.1",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "ava": {
        "files": [
            "dist/**/*.test.js"
        ],
        "workerThreads": false,
        "concurrency": 1
    },
    "homepage": "https://github.com/source-repo/rpc/tree/main/packages/diagnostics#readme",
    "bugs": {
        "url": "https://github.com/source-repo/rpc/issues"
    }
}
