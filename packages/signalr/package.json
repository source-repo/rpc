{
    "name": "@source-repo/signalr",
    "version": "4.6.0",
    "description": "Source RPC over ASP.NET Core SignalR: a client transport that dials into a C# hub, so a .NET process can be an ordinary peer",
    "keywords": [
        "signalr",
        "aspnetcore",
        "dotnet",
        "rpc",
        "transport",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/signalr"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "csharp",
        "!dist/**/*.test.*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run clean && npm run build && ava",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@microsoft/signalr": "^10.0.11",
        "@microsoft/signalr-protocol-msgpack": "^10.0.11",
        "@source-repo/rpc": "^4.6.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "ava": "^8.0.1",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "ava": {
        "files": [
            "dist/**/*.test.js"
        ],
        "workerThreads": false,
        "concurrency": 1
    }
}
