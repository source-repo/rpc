{
    "name": "@source-repo/query",
    "version": "5.3.2",
    "description": "The pull half of a Source RPC network: a TanStack Query cache over $data, with freshness taken from the component channel rather than from a clock",
    "keywords": [
        "rpc",
        "tanstack-query",
        "cache",
        "scada",
        "mqtt",
        "socket.io",
        "typescript"
    ],
    "type": "module",
    "license": "MIT",
    "author": "anderswestberg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/source-repo/rpc.git",
        "directory": "packages/query"
    },
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run clean && npm run build && ava",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "@source-repo/rpc": "^5.3.2",
        "@tanstack/query-core": "^5.102.5"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "ava": "^8.0.1",
        "rimraf": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "ava": {
        "files": [
            "dist/**/*.test.js"
        ],
        "workerThreads": false,
        "concurrency": 1
    },
    "homepage": "https://github.com/source-repo/rpc/tree/main/packages/query#readme",
    "bugs": {
        "url": "https://github.com/source-repo/rpc/issues"
    }
}
