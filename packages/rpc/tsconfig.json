{
    "compilerOptions": {
        "target": "ES2022",
        // ES2024 for the library only, and for one symbol: Atomics.waitAsync, which is how a
        // supervisor waits for a worker to park without becoming the thing that is parked. The emit
        // target stays where it was.
        "lib": ["ES2024", "DOM"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,

        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,

        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"]
}
